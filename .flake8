[flake8]
max-line-length = 100
exclude = 
    .git,
    __pycache__,
    venv,
    env,
    build,
    dist,
    .eggs
ignore = 
    E203,  # whitespace before ':'
    W503,  # line break before binary operator

[isort]
profile = black
line_length = 100
skip = venv,env,.git

[mypy]
python_version = 3.8
warn_return_any = True
warn_unused_configs = True
ignore_missing_imports = True
